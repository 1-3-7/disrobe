{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://disrobe.dev/schemas/chain.v1.json",
  "title": "Disrobe Chain-Detect Plan",
  "description": "Versioned JSON envelope emitted by `disrobe --chain ...`. Records the tree of detection layers, picks, verdicts, and aggregate stats for one chain-detect run. See `.developer/chain-detect-spec-2026-05-25.md` for the design.",
  "type": "object",
  "required": [
    "schema",
    "tool_version",
    "input",
    "spec",
    "topology",
    "root_node_id",
    "nodes",
    "verdict",
    "stats"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "disrobe.chain/v1",
      "description": "Stable schema URI. Additive-only changes within v1; renames or removals bump to v2."
    },
    "tool_version": {
      "type": "string",
      "description": "Semver of the disrobe tool that produced this document.",
      "minLength": 1
    },
    "input": {
      "$ref": "#/$defs/Input"
    },
    "spec": {
      "$ref": "#/$defs/Spec"
    },
    "topology": {
      "$ref": "#/$defs/Topology"
    },
    "root_node_id": {
      "type": "integer",
      "minimum": 0
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Node"
      }
    },
    "verdict": {
      "$ref": "#/$defs/Verdict"
    },
    "final_format": {
      "type": [
        "string",
        "null"
      ],
      "description": "Human label of the recovered output format; set iff verdict in {complete, fan-out-partial}."
    },
    "stats": {
      "$ref": "#/$defs/Stats"
    }
  },
  "$defs": {
    "Input": {
      "type": "object",
      "required": [
        "blake3",
        "size",
        "detected"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "blake3": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "detected": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "Spec": {
      "type": "object",
      "required": [
        "raw",
        "kind",
        "cap"
      ],
      "additionalProperties": false,
      "properties": {
        "raw": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "auto",
            "explicit",
            "prefix-then-auto",
            "plan-only"
          ]
        },
        "cap": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        }
      }
    },
    "Topology": {
      "enum": [
        "linear",
        "tree"
      ]
    },
    "Verdict": {
      "enum": [
        "ok",
        "complete",
        "fan-out",
        "fan-out-partial",
        "stalled",
        "cycle",
        "cap-reached",
        "error",
        "dry-run"
      ]
    },
    "ConfidenceBand": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "OutputKind": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "language",
            "formatted"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "source"
            },
            "language": {
              "type": "string"
            },
            "formatted": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "format_tag",
            "family"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "bytes"
            },
            "format_tag": {
              "type": "string"
            },
            "family": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "children"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "mixed"
            },
            "children": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ChildHandle"
              }
            }
          }
        }
      ]
    },
    "ChildHandle": {
      "type": "object",
      "required": [
        "artifact_index",
        "relative_path"
      ],
      "additionalProperties": false,
      "properties": {
        "artifact_index": {
          "type": "integer",
          "minimum": 0
        },
        "relative_path": {
          "type": "string"
        },
        "hint": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "DetectorPick": {
      "type": "object",
      "required": [
        "pass_id",
        "format_tag",
        "family",
        "confidence",
        "band",
        "specificity",
        "markers",
        "explain",
        "chosen"
      ],
      "additionalProperties": false,
      "properties": {
        "pass_id": {
          "type": "string"
        },
        "format_tag": {
          "type": "string"
        },
        "family": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "band": {
          "$ref": "#/$defs/ConfidenceBand"
        },
        "specificity": {
          "type": "integer",
          "minimum": 0
        },
        "markers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "explain": {
          "type": "string"
        },
        "chosen": {
          "type": "boolean"
        }
      }
    },
    "Node": {
      "type": "object",
      "required": [
        "id",
        "parent_id",
        "depth",
        "branch_id",
        "pass",
        "format_tag_in",
        "input_blake3",
        "input_size",
        "output_kind",
        "output_blake3",
        "output_size",
        "duration_ms",
        "detector_picks",
        "artifacts",
        "metadata",
        "verdict",
        "error"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0
        },
        "parent_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        },
        "branch_id": {
          "type": "string",
          "pattern": "^[a-z]+$"
        },
        "pass": {
          "type": [
            "string",
            "null"
          ]
        },
        "format_tag_in": {
          "type": [
            "string",
            "null"
          ]
        },
        "input_blake3": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "input_size": {
          "type": "integer",
          "minimum": 0
        },
        "output_kind": {
          "oneOf": [
            {
              "$ref": "#/$defs/OutputKind"
            },
            {
              "type": "null"
            }
          ]
        },
        "output_blake3": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "output_size": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "duration_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "detector_picks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DetectorPick"
          }
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "verdict": {
          "$ref": "#/$defs/Verdict"
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "Stats": {
      "type": "object",
      "required": [
        "layers",
        "branches",
        "total_ms",
        "max_branch_depth",
        "detector_calls",
        "rejected_passes"
      ],
      "additionalProperties": false,
      "properties": {
        "layers": {
          "type": "integer",
          "minimum": 0
        },
        "branches": {
          "type": "integer",
          "minimum": 0
        },
        "total_ms": {
          "type": "integer",
          "minimum": 0
        },
        "max_branch_depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        },
        "detector_calls": {
          "type": "integer",
          "minimum": 0
        },
        "rejected_passes": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
