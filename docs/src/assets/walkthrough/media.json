  "cues": [
    {
      "id": "identify",
      "chapter": "Unpack and route",
      "title": "Recognize the packed executable",
      "description": "Inspect the file's packer evidence before choosing a recovery path.",
      "startMs": 4000,
      "endMs": 10000,
      "command": "disrobe identify hello.packed.exe"
    },
    {
      "id": "native",
      "chapter": "Unpack and route",
      "title": "Unpack the native payload",
      "description": "Recover the UPX payload as a separate binary.",
      "startMs": 10000,
      "endMs": 16000,
      "command": "disrobe native unpack hello.packed.exe --out recovered/hello.bin"
    },
    {
      "id": "extract",
      "chapter": "Unpack and route",
      "title": "Open the application container",
      "description": "Extract the APK's archive members into a directory.",
      "startMs": 16000,
      "endMs": 22000,
      "command": "disrobe extract fixture.apk --out recovered/archive"
    },
    {
      "id": "auto",
      "chapter": "Unpack and route",
      "title": "Let Disrobe choose the passes",
      "description": "Keep the recovery report and each executed stage's output.",
      "startMs": 22000,
      "endMs": 28000,
      "command": "disrobe auto add.wasm --out recovered/auto --capture-stages"
    },
    {
      "id": "python",
      "chapter": "Recover readable code",
      "title": "Recover Python from bytecode",
      "description": "Decompile the code object without invoking Python for a round-trip check.",
      "startMs": 28000,
      "endMs": 34000,
      "command": "disrobe py decompile hello.pyc --out recovered/python --no-roundtrip"
    },
    {
      "id": "lua",
      "chapter": "Recover readable code",
      "title": "Read the Lua program",
      "description": "Turn the compiled chunk into Lua source.",
      "startMs": 34000,
      "endMs": 40000,
      "command": "disrobe lua decompile greet.luac --out recovered/greet.lua"
    },
    {
      "id": "unbundle",
      "chapter": "Recover readable code",
      "title": "Separate the bundled modules",
      "description": "Split the Webpack bundle into individual module files.",
      "startMs": 40000,
      "endMs": 46000,
      "command": "disrobe js unbundle bundle.js --out recovered/modules"
    },
    {
      "id": "sourcemap",
      "chapter": "Recover readable code",
      "title": "Restore the embedded originals",
      "description": "Write the original sources retained in the source map.",
      "startMs": 46000,
      "endMs": 52000,
      "command": "disrobe js sourcemap bundle.js.map --out recovered/sources"
    },
    {
      "id": "wasm",
      "chapter": "Recover readable code",
      "title": "Read WebAssembly instructions",
      "description": "The WAT retains the exported add function and its i32.add instruction.",
      "startMs": 52000,
      "endMs": 58000,
      "command": "disrobe wasm decompile add.wasm --target wat --out recovered/add.wat"
    },
    {
      "id": "apk",
      "chapter": "Inspect the evidence",
      "title": "Decode Android resources",
      "description": "Read the package, resource names and decoded manifest.",
      "startMs": 58000,
      "endMs": 64000,
      "command": "disrobe apk fixture.apk --out recovered/android"
    },
    {
      "id": "indicators",
      "chapter": "Inspect the evidence",
      "title": "Extract indicators",
      "description": "Find the URL, email address and documentation-range IP in these input bytes.",
      "startMs": 64000,
      "endMs": 70000,
      "command": "disrobe ioc indicators.txt"
    },
    {
      "id": "strings",
      "chapter": "Inspect the evidence",
      "title": "Inspect the original strings",
      "description": "List printable strings with decoding disabled.",
      "startMs": 70000,
      "endMs": 76000,
      "command": "disrobe strings indicators.txt --no-decode"
    },
    {
      "id": "context",
      "chapter": "Keep the recovery evidence",
      "title": "Review the chain's verdict",
      "description": "Read the pass status and producer-reported recovery tiers.",
      "startMs": 76000,
      "endMs": 82000,
      "command": "disrobe context --out recovered/auto"
    },
    {
      "id": "report",
      "chapter": "Keep the recovery evidence",
      "title": "Export the completed run",
      "description": "Save a Markdown report from the existing recovery directory.",
      "startMs": 82000,
      "endMs": 88000,
      "command": "disrobe report recovered/auto --format markdown > recovered/report.md"
    },
    {
      "id": "envelope",
      "chapter": "Keep the recovery evidence",
      "title": "Package the original bytes",
      "description": "Create a Raw-rung envelope carrying the WebAssembly input.",
      "startMs": 88000,
      "endMs": 94000,
      "command": "disrobe envelope create add.wasm --out recovered/add.dr --format wasm --no-cache"
    },
    {
      "id": "verify",
      "chapter": "Keep the recovery evidence",
      "title": "Verify the envelope hash",
      "description": "Check the stored payload against its BLAKE3 root hash.",
      "startMs": 94000,
      "endMs": 100000,
      "command": "disrobe verify recovered/add.dr"
    },
    {
      "id": "init",
      "chapter": "Work with your tools",
      "title": "Create an IDE workspace",
      "description": "Generate the workspace and Claude integration files in this project.",
      "startMs": 100000,
      "endMs": 106000,
      "command": "disrobe init --ide claude"
    },
    {
      "id": "rename",
      "chapter": "Work with your tools",
      "title": "Keep a named analyst note",
      "description": "Record the proposed symbol name separately from recovered evidence.",
      "startMs": 106000,
      "endMs": 112000,
      "command": "disrobe rename func_0 add --note 'two integer inputs'"
    },
    {
      "id": "config",
      "chapter": "Work with your tools",
      "title": "Write the project configuration",
      "description": "Generate the documented configuration template.",
      "startMs": 112000,
      "endMs": 118000,
      "command": "disrobe config init"
    },
    {
      "id": "completions",
      "chapter": "Work with your tools",
      "title": "Add shell completions",
      "description": "Generate the Bash completion script as a file.",
      "startMs": 118000,
      "endMs": 124000,
      "command": "disrobe completions bash > recovered/disrobe.bash"
    }
  ],
