  "cues": [
    {
      "id": "native",
      "title": "Unpack a native binary",
      "description": "Decode the UPX payload from a packed executable.",
      "startMs": 0,
      "endMs": 6000,
      "command": "disrobe native unpack hello.packed.exe --out recovered/hello.bin"
    },
    {
      "id": "indicators",
      "title": "Extract indicators",
      "description": "Find the URL, email address, and IP address in a file.",
      "startMs": 6000,
      "endMs": 11000,
      "command": "disrobe ioc indicators.txt"
    },
    {
      "id": "auto",
      "title": "Let Disrobe choose the recovery path",
      "description": "Identify the module and save its recovery reports and stages.",
      "startMs": 11000,
      "endMs": 16000,
      "command": "disrobe auto add.wasm --out recovered/auto --capture-stages"
    },
    {
      "id": "lua",
      "title": "Decompile Lua bytecode",
      "description": "Recover source from a compiled Lua chunk.",
      "startMs": 16000,
      "endMs": 22000,
      "command": "disrobe lua decompile greet.luac --out recovered/greet.lua"
    },
    {
      "id": "wasm",
      "title": "Lift WebAssembly to WAT",
      "description": "Write the module's functions and instructions as text.",
      "startMs": 22000,
      "endMs": 28000,
      "command": "disrobe wasm decompile add.wasm --target wat --out recovered/add.wat"
    },
    {
      "id": "source",
      "title": "Read the recovered instructions",
      "description": "The exported add function retains its two inputs and i32.add instruction.",
      "startMs": 28000,
      "endMs": 36000,
      "command": "Get-Content -LiteralPath recovered/add.wat"
    }
  ],
