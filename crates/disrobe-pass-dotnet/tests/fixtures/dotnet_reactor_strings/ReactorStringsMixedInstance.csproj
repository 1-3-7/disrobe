<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>ReactorStringsMixedInstance</AssemblyName>
    <RootNamespace>ReactorStringsCompat</RootNamespace>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Optimize>false</Optimize>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>MIXED_INSTANCE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Host.cs" />
    <Compile Include="Offsets.g.cs" />
    <EmbeddedResource Include="decoy.bin" LogicalName="00-reactor-decoy" />
    <EmbeddedResource Include="strings.bin" LogicalName="reactor-static-strings" />
  </ItemGroup>
</Project>
