# chain golden-test scratch outputs (the .chain.json goldens are tracked; .actual.json are per-run)
corpus/**/*.actual.json

# py-decompile playground corpus: small reproducible fixtures the decompiler tests pin against
# (marquee include_bytes!, determinism, megafile/roundtrip-metric matrices, playground_strict,
# cli chain extractors). un-ignored per CONTRIBUTING; regen via scripts/rebuild-playground-pyc.ps1.
!corpus/python/decompile/playground/
!corpus/python/decompile/playground/__pycache__/
!corpus/python/decompile/playground/*.py
!corpus/python/decompile/playground/*.toml
!corpus/python/decompile/playground/*.pyc
!corpus/python/decompile/playground/__pycache__/*.pyc

!corpus/native/packers/mew/*.exe

!corpus/python/pyarmor/**/*.pyd
!corpus/python/pyarmor/**/*.so
