    language: str, source: str | bytes
) -> (
    dict[str, Any]
    | GoAnalysis
    | SwiftReport
    | JvmClass
    | RubyAnalysis
    | LuaDecompilation
    | PhpDecode
    | JsUnminify
):
    """Parse a language artifact into a structured record.

    Returns a typed report for the structural-recovery languages: ``go`` ->
    :class:`GoAnalysis`, ``swift``/``objc`` -> :class:`SwiftReport`, ``kotlin``
    -> :class:`JvmClass`, ``ruby`` -> :class:`RubyAnalysis`, ``lua`` ->
    :class:`LuaDecompilation`, ``php`` -> :class:`PhpDecode`, and
    ``javascript``/``js``/``typescript``/``ts`` -> :class:`JsUnminify`. The
    container/bytecode formats (``pyc``, ``jvm-class``, ``dex``, ``wasm``,
    ``hermes``, ``beam``) return a nested ``dict`` because their full parse
    record has no single fixed typed shape.
    """
