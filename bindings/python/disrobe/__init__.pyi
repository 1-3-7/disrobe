class Instruction:
    """A single recovered disassembly instruction with editable fields."""

    def __init__(
        self,
        offset: int,
        mnemonic: str,
        operands: list[str] | None = None,
        bytes: bytes | None = None,
    ) -> None: ...
    offset: int
    mnemonic: str
    operands: list[str]
    bytes: bytes
    branch_target: int | None
    @property
    def flow(self) -> InstructionFlow: ...
    def text(self) -> str: ...

class Symbol:
    """A single recovered symbol with editable address, name, and kind."""

    def __init__(self, address: int, name: str, kind: SymbolKind = "function") -> None: ...
    address: int
    name: str
    kind: SymbolKind

class CodeObject:
    """A mutable, re-serializable recovered code object backed by a .dr envelope.

    Load an existing Disasm- or Raw-rung .dr envelope, edit its instructions, symbols,
    provenance metadata, capabilities, or attached LLM sidecar, then call
    ``to_dr()`` to produce a fresh, integrity-hashed .dr envelope.
    """

    def __init__(self) -> None: ...
    @staticmethod
    def from_dr(dr_bytes: bytes) -> "CodeObject": ...
    @property
    def instructions(self) -> list[Instruction]: ...
    def set_instructions(self, instructions: list[Instruction]) -> None: ...
    def add_instruction(self, instruction: Instruction) -> None: ...
    @property
    def symbols(self) -> list[Symbol]: ...
    def set_symbols(self, symbols: list[Symbol]) -> None: ...
    def add_symbol(self, symbol: Symbol) -> None: ...
    @property
    def instruction_count(self) -> int: ...
    @property
    def symbol_count(self) -> int: ...
    source_hash: str
    produced_by: str
    @property
    def metadata(self) -> dict[str, str]: ...
    def set_metadata(self, key: str, value: str) -> None: ...
    def clear_metadata(self) -> None: ...
    @property
    def capabilities(self) -> list[str]: ...
    def add_capability(self, name: str, major: int) -> None: ...
    @property
    def llm(self) -> dict[str, Any] | None: ...
    def set_llm(self, sidecar: dict[str, Any] | None) -> None: ...
    def to_dr(self) -> bytes: ...

@runtime_checkable
class Pass(Protocol):
    """A custom pass registered via ``register_pass``: a callable mapping the
    incoming ``bytes`` (or a prior pass's return) to any output object."""

    def __call__(self, data: Any) -> Any: ...

@runtime_checkable
class OutputConsumer(Protocol):
    """A custom output consumer registered via ``register_consumer``: a callable
    invoked with a report object and optional keyword context."""

    def __call__(self, result: Any, **context: Any) -> Any: ...

