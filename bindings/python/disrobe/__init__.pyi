class LlmBundle(TypedDict, total=False):
    """Top-level shape of ``result["llm"]`` when an LLM metadata pack was emitted.

    Mirrors the on-disk ``disrobe.metadata.llm.v1`` schema produced by the CLI
    ``--llm`` flag family. Keys present depend on which ``pack`` was requested.
    """

    schema: str
    schema_version: str
    generated_at: str
    tool: dict[str, Any]
    selection: dict[str, Any]
    input: dict[str, Any]
    pipeline: list[dict[str, Any]]
    categories: dict[str, Any]

class DisrobeError(Exception):
    """Raised by every disrobe binding when the underlying pass fails."""

class UnsupportedLanguage(DisrobeError):
    """Raised by ``disasm``, ``parse``, ``compile``, ``decompile`` for languages
    with no backing implementation in the current build. The message includes a
    hint pointing at the equivalent CLI subcommand or upstream tool."""

class _Report:
    """Base shape shared by every typed analysis report.

    Concrete subclasses add field accessors; this base documents the common
    serialization surface every report carries.
    """

    @property
    def raw(self) -> dict[str, Any]:
        """The full underlying record as a nested dict (no detail dropped)."""
        ...

    def to_json(self) -> str:
        """Serialize the full record to a compact JSON string."""
        ...

    @classmethod
    def from_json_str(cls, text: str) -> Self:
        """Rebuild a report from a JSON string produced by ``to_json``."""
        ...

    @classmethod
    def from_obj(cls, obj: dict[str, Any]) -> Self:
        """Wrap an already-decoded dict as a typed report."""
        ...

