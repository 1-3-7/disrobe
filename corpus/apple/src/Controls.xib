<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.XIB" version="3.0" toolsVersion="23504" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES">
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="23506"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <objects>
        <placeholder placeholderIdentifier="IBFilesOwner" id="-1" userLabel="File's Owner" customClass="ControlsViewController" customModule="Fixture">
            <connections>
                <outlet property="titleLabel" destination="lbl-01-aaa" id="out-01-aaa"/>
                <outlet property="enabledSwitch" destination="swt-01-aaa" id="out-02-aaa"/>
                <outlet property="view" destination="root-0-aaa" id="out-03-aaa"/>
            </connections>
        </placeholder>
        <placeholder placeholderIdentifier="IBFirstResponder" id="-2" customClass="UIResponder"/>
        <view contentMode="scaleToFill" id="root-0-aaa">
            <rect key="frame" x="0.0" y="0.0" width="390" height="844"/>
            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
            <subviews>
                <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="Fixture title" textAlignment="natural" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="lbl-01-aaa">
                    <rect key="frame" x="20" y="80" width="350" height="21"/>
                    <fontDescription key="fontDescription" type="system" pointSize="17"/>
                    <nil key="textColor"/>
                    <nil key="highlightedColor"/>
                </label>
                <button opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" buttonType="system" lineBreakMode="middleTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="btn-01-aaa">
                    <rect key="frame" x="20" y="120" width="120" height="34"/>
                    <state key="normal" title="Save changes"/>
                    <connections>
                        <action selector="saveTapped:" destination="-1" eventType="touchUpInside" id="act-01-aaa"/>
                    </connections>
                </button>
                <switch opaque="NO" contentMode="scaleToFill" horizontalHuggingPriority="750" verticalHuggingPriority="750" contentHorizontalAlignment="center" contentVerticalAlignment="center" on="YES" translatesAutoresizingMaskIntoConstraints="NO" id="swt-01-aaa">
                    <rect key="frame" x="20" y="170" width="51" height="31"/>
                    <connections>
                        <action selector="toggleChanged:" destination="-1" eventType="valueChanged" id="act-02-aaa"/>
                    </connections>
                </switch>
            </subviews>
            <viewLayoutGuide key="safeArea" id="safe-0-aaa"/>
            <color key="backgroundColor" systemColor="systemBackgroundColor"/>
            <constraints>
                <constraint firstItem="lbl-01-aaa" firstAttribute="leading" secondItem="safe-0-aaa" secondAttribute="leading" constant="20" id="con-01-aaa"/>
                <constraint firstItem="lbl-01-aaa" firstAttribute="top" secondItem="safe-0-aaa" secondAttribute="top" constant="36" id="con-02-aaa"/>
                <constraint firstItem="btn-01-aaa" firstAttribute="leading" secondItem="lbl-01-aaa" secondAttribute="leading" id="con-03-aaa"/>
                <constraint firstItem="btn-01-aaa" firstAttribute="top" secondItem="lbl-01-aaa" secondAttribute="bottom" constant="19" id="con-04-aaa"/>
                <constraint firstItem="swt-01-aaa" firstAttribute="leading" secondItem="lbl-01-aaa" secondAttribute="leading" id="con-05-aaa"/>
                <constraint firstItem="swt-01-aaa" firstAttribute="top" secondItem="btn-01-aaa" secondAttribute="bottom" constant="16" id="con-06-aaa"/>
            </constraints>
        </view>
    </objects>
    <resources>
        <systemColor name="systemBackgroundColor">
            <color white="1" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
        </systemColor>
    </resources>
</document>
