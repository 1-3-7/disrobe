                    <constraint firstItem="lbl-01-bbb" firstAttribute="leading" secondItem="fld-01-bbb" secondAttribute="trailing" constant="14" id="con-03-bbb"/>
                    <constraint firstItem="lbl-01-bbb" firstAttribute="top" secondItem="fld-01-bbb" secondAttribute="top" id="con-04-bbb"/>
