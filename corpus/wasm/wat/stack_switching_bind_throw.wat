(module
  (type $ft0 (func (param i32) (result i32)))
  (type $ct0 (cont $ft0))
  (type $ft1 (func (result i32)))
  (type $ct1 (cont $ft1))
  (tag $yield (param i32))
  (tag $cancel)
  (elem declare func $worker)
  (func $worker (param $seed i32) (result i32)
    (suspend $yield (local.get $seed))
    (local.get $seed)
    (i32.const 1)
    (i32.add))
  (func (export "drive") (param $seed i32) (result i32)
    (local $k (ref null $ct1))
    (local.set $k
      (cont.bind $ct0 $ct1 (local.get $seed) (cont.new $ct0 (ref.func $worker))))
    (block $on_yield (result i32 (ref $ct1))
      (resume $ct1 (on $yield $on_yield) (local.get $k))
      (return))
    (local.set $k)
    (drop)
    (block $thrown (result i32)
      (block $on_yield2 (result i32 (ref $ct1))
        (resume_throw $ct1 $cancel (on $yield $on_yield2) (local.get $k))
        (br $thrown))
      (drop)
      (drop)
      (i32.const -1))
    (return)))
