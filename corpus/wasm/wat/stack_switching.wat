(module
  (type $ft (func (result i32)))
  (type $ct (cont $ft))
  (tag $yield (param i32))
  (elem declare func $worker)
  (func $worker (result i32)
    (suspend $yield (i32.const 11))
    (suspend $yield (i32.const 22))
    (i32.const 33))
  (func (export "main") (result i32)
    (local $sum i32)
    (local $k (ref null $ct))
    (local.set $k (cont.new $ct (ref.func $worker)))
    (loop $again (result i32)
      (block $on_yield (result i32 (ref $ct))
        (resume $ct (on $yield $on_yield) (local.get $k))
        (return))
      (local.set $k)
      (local.set $sum (i32.add (local.get $sum)))
      (br $again))))
